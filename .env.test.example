# Template for .env.test, the connection file of the local test Nextcloud.
#
# The real .env.test is written by scripts/bootstrap_test_nc.sh and is git-ignored,
# because it carries two working app passwords. This example only names the variables.
#
#   docker compose -f compose.test.yml up -d --wait
#   bash scripts/bootstrap_test_nc.sh
#   set -a && . ./.env.test && set +a && uv run pytest -m integration -q

NC_MCP_URL=http://127.0.0.1:8080
NC_MCP_USER=alice
NC_MCP_APP_PASSWORD=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx

# Second, restricted user for the permission tests of the later plans.
NC_MCP_TEST_USER2=bob
NC_MCP_TEST_APP_PASSWORD2=xxxxx-xxxxx-xxxxx-xxxxx-xxxxx

# The two Talk test conversations of plan 09-05, created by ensure_talk_room and owned by
# NC_MCP_USER: one writable and one write protected. The write protected one carries the
# negative case of TALK-03. Without these two values the Talk round trip test skips.
NC_MCP_TEST_TALK_ROOM=MCP-Talk-offen-Grüße-aus-Hamburg
NC_MCP_TEST_TALK_READONLY_ROOM=MCP-Talk-nurlesen-Straße-ohne-Ausgang
