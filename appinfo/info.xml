				<access_level>PUBLIC</access_level>
				<headers_to_exclude>["AUTHORIZATION-APP-API","EX-APP-ID","EX-APP-VERSION","AA-VERSION","X-ORIGIN-IP"]</headers_to_exclude>
			</route>
			<route>
				<url>^/revoke/?$</url>
				<verb>POST</verb>
				<access_level>PUBLIC</access_level>
				<headers_to_exclude>["AUTHORIZATION-APP-API","EX-APP-ID","EX-APP-VERSION","AA-VERSION","X-ORIGIN-IP"]</headers_to_exclude>
			</route>
			<route>
				<url>^/connections/?$</url>
				<verb>GET,POST</verb>
				<access_level>PUBLIC</access_level>
				<headers_to_exclude>["AUTHORIZATION-APP-API","EX-APP-ID","EX-APP-VERSION","AA-VERSION","X-ORIGIN-IP"]</headers_to_exclude>
			</route>
		</routes>
		<!--
		  - The six variables an administrator may set, and the only way to set them: the
		  - deploy daemon injects a variable into the container if, and only if, the
		  - manifest declares it here (AppAPI ExAppService::getAppInfo, measured in plan
		  - 03-08). Without the declaration, the "env" option of `occ app_api:app:register`
		  - is accepted and silently dropped, and the app then runs on the defaults of
		  - src/mcp_connector/config.py and src/mcp_connector/oauth/registry.py.
		  -
		  - NC_MCP_PUBLIC_URL is the one that has to be set on every installation. The
		  - authorization server calls itself by it: it is the issuer of the metadata
		  - document, the resource of the protected resource document and the target of the
		  - resource_metadata pointer in every 401. Left empty, all three name the
		  - documented default http://127.0.0.1:8765 and no client can complete a
		  - connection (docs/oauth-setup.md).
		  -
		  - NC_MCP_TALK_SEND is the one variable here that is not about connecting an
		  - assistant. It closes the outgoing Talk channel of this app for the whole
		  - instance: with it off no assistant can send a Talk message through this
		  - connector, while reading conversations and their history stays untouched. It is
		  - on unless it is set to off, because the switch is the countermeasure for that
		  - channel and not its precondition (TALK-04).
		  -
		  - The three switches of AUTH-07, the one of AUTH-08 and the one of TALK-04 are
		  - declared for the administrator who needs them, with their shipped defaults
		  - empty so nothing here
		  - overrides the code: AppAPI drops a variable with an empty value instead of
		  - exporting it blank. An empty <default> element is worse than none at all, because
		  - AppAPI 34.0.3 exports it as the string "Array" and the store answers the upload
		  - with a 500 (pitfall 3 of 05-RESEARCH.md, held by the variable gate of
		  - tests/unit/test_exapp_env_setup.py).
		-->
		<environment-variables>
			<variable>
				<name>NC_MCP_PUBLIC_URL</name>
				<display-name>Public URL of this app</display-name>
				<description>The address this app is reachable under from the internet, without a trailing slash, for example https://cloud.example.com/exapps/mcp_connector. Required for OAuth.</description>			</variable>
			<variable>
				<name>NC_MCP_OAUTH_DCR</name>
				<display-name>Allow clients to register themselves</display-name>
				<description>Dynamic client registration (RFC 7591). On unless set to off. Claude.ai and ChatGPT need it to connect without an administrator.</description>			</variable>
			<variable>
				<name>NC_MCP_OAUTH_CIMD</name>
				<display-name>Allow clients to identify by their own document</display-name>
				<description>Client ID Metadata Documents, the way of the MCP specification 2026-07-28: a client names the address of a metadata document it publishes itself instead of registering here. On unless set to off. Setting NC_MCP_OAUTH_DCR to off switches this way off as well, so a closed door cannot be walked around through the other spelling.</description>			</variable>
			<variable>
				<name>NC_MCP_OAUTH_ALLOWLIST_ONLY</name>
				<display-name>Only allow listed clients</display-name>
				<description>Off unless set to on. With it on, only the clients named below may authorize, and an empty list closes the door for everyone.</description>			</variable>
			<variable>
				<name>NC_MCP_OAUTH_ALLOWED_CLIENTS</name>
				<display-name>Allowed clients</display-name>
				<description>Comma separated client ids or redirect URIs. Only read when the allowlist above is on.</description>			</variable>
			<variable>
				<name>NC_MCP_TALK_SEND</name>
				<display-name>Let assistants send Talk messages</display-name>
				<description>The outgoing Talk channel of this app. On unless set to off. With it off no assistant can send a Talk message through this connector, whatever an account is allowed to do in Talk itself; reading conversations and their history is not affected.</description>			</variable>
		</environment-variables>
	</external-app>
</info>
